import Ariadne.Audit

/-!
# `lake exe audit [--write-lock]`

The soundness gate for Ariadne itself (see `Ariadne/Audit.lean`). `trusted.lock` holds the trusted base:
the model of JavaScript's entry points (`run`, `runMethod`, `runMethodStore`) and `Converges`, the
relations the per-file theorems state results in (`Ty.Rep`, `ArgsRep`), everything they use, and the
statements of the theorems users rely on. A change
to any of it is a change to `trusted.lock`, to review.
-/

unsafe def main (args : List String) : IO UInt32 :=
  Ariadne.Audit.run {
    modules := #[`Ariadne, `Tests]
    project := [`Ariadne, `Tests]
    -- What the per-file theorems mention: the model's entry points and `Converges`, and the relations
    -- between JavaScript values and denoted ones; with everything they use.
    lockNames := [`Ariadne.run, `Ariadne.runMethod, `Ariadne.runMethodStore, `Ariadne.Converges,
      `Ariadne.Ty.Rep, `Ariadne.ArgsRep]
    lockStatements := [`Ariadne.adequacy, `Ariadne.adequacy_state, `Ariadne.adequacy_state_store,
      `Ariadne.source_of, `Ariadne.source_state_of, `Ariadne.runMethod_store, `Ariadne.scoped_pure_keeps]
    lockPath := "trusted.lock"
    lockHeader := "-- trusted.lock: Ariadne's trusted base. Generated by `lake exe audit --write-lock`; review every change." } args
