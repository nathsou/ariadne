theorem parse_checked : parse source = .ok program := by
  unfold parse
  rw [lex_checked]
  kernel_rfl

theorem types_checked : Check.program program = .ok () := by kernel_rfl

theorem source_checked : frontend source = .ok program :=
  frontend_of_parse parse_checked types_checked

def certificate : Certificate source := ⟨program, source_checked⟩

/-- Executable, fuel-indexed model of TypeScript `searchCallbacks`. -/
def ts_searchCallbacks (fuel : Nat) (args : List Value) : Result Value :=
  run program "searchCallbacks" fuel args

theorem ts_searchCallbacks_source {fuel : Nat} {args : List Value} {value : Value}
    (h : ts_searchCallbacks fuel args = .ok value) : SourceReturns source "searchCallbacks" args value :=
  certificate.transfer_at h

