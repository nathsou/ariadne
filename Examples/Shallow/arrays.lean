theorem parse_checked : parse source = .ok program := by
  unfold parse
  rw [lex_checked]
  kernel_rfl

theorem types_checked : Check.program program = .ok () := by kernel_rfl

theorem source_checked : frontend source = .ok program :=
  frontend_of_parse parse_checked types_checked

def certificate : Certificate source := ⟨program, source_checked⟩

/-- Executable, fuel-indexed model of TypeScript `transform`. -/
def ts_transform (fuel : Nat) (args : List Value) : Result Value :=
  run program "transform" fuel args

theorem ts_transform_source {fuel : Nat} {args : List Value} {value : Value}
    (h : ts_transform fuel args = .ok value) : SourceReturns source "transform" args value :=
  certificate.transfer_at h

