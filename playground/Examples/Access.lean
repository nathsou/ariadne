    let «this» : Access := { «this» with roles := Ariadne.mapDel «this».roles user }
    «this»

def suspend («this» : Access) («by» : JSString) (user : JSString) : Access :=
  if (!(isOwner «this» «by»)) || («by» == user) then
    «this»
  else
