    | none =>
      false
    | some role =>
      role == Role.owner

def canRead («this» : Access) (user : JSString) : Bool :=
  if (Ariadne.mapGet «this».suspended user).isSome then
    false
  else
    (Ariadne.mapGet «this».roles user).isSome

def canWrite («this» : Access) (user : JSString) : Bool :=
  if (Ariadne.mapGet «this».suspended user).isSome then
    false
  else
    let role : Option Role := Ariadne.mapGet «this».roles user
    match role with
    | none =>
      false
    | some role =>
      (role == Role.editor) || (role == Role.owner)

