  Ariadne.forIn facts.zipIdx (fun (f, n10') next2' exit2' (older, notOwner, damaged, opened, ok, floorSeed, taggedFactors, committedFactors, facts, floor, ()) =>
    let index := (n10' : Int)
    match f with
