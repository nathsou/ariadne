def area (s : Shape) : Int :=
  match s with
  | Shape.circle s =>
    ((3 : Int) * s.r) * s.r
  | Shape.rect s =>
    s.w * s.h
  | Shape.dot =>
    (0 : Int)

/-- The inputs on which `area` stays within what the model covers. -/
def area.safe (s : Shape) : Bool :=
  match s with
  | Shape.circle s =>
    Ariadne.inRange ((3 : Int) * s.r) && Ariadne.inRange (((3 : Int) * s.r) * s.r)
  | Shape.rect s =>
    Ariadne.inRange (s.w * s.h)
  | Shape.dot =>
    true

def widen (s : Shape) (d : Int) : Shape :=
  match s with
  | Shape.circle s =>
    let bigger : Circle := { s with r := s.r + d }
    (Shape.circle bigger)
  | Shape.rect s =>
    let wider : Rect := { s with w := s.w + d }
    (Shape.rect wider)
  | Shape.dot =>
    s

/-- The inputs on which `widen` stays within what the model covers. -/
def widen.safe (s : Shape) (d : Int) : Bool :=
  match s with
  | Shape.circle s =>
    Ariadne.inRange (s.r + d) && (let bigger : Circle := { s with r := s.r + d }
    true)
  | Shape.rect s =>
    Ariadne.inRange (s.w + d) && (let wider : Rect := { s with w := s.w + d }
    true)
  | Shape.dot =>
    true

def unit (n : Int) : Shape :=
  if decide (n > (0 : Int)) then
    (Shape.rect (Rect.mk n n))
  else
    if decide (n < (0 : Int)) then
      (Shape.circle (Circle.mk (-n)))
    else
      Shape.dot

/-- The inputs on which `unit` stays within what the model covers. -/
def unit.safe (n : Int) : Bool :=
  if decide (n > (0 : Int)) then
    true
  else
    if decide (n < (0 : Int)) then
      Ariadne.inRange (-n)
    else
      true

def circleOf (c : Circle) : Int :=
  c.r

def side (s : (Int × Int × Unit) ⊕ (Int × Unit) ⊕ Unit) : Int :=
  match s with
  | Sum.inl s =>
    let s := (Rect.mk s.1 s.2.1)
    let t : Int := s.w + s.h
    t
  | Sum.inr p' =>
