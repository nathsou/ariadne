def total (a : Int) (b : Int) : Int :=
  a + (b * (2 : Int))

/-- The inputs on which `total` stays within what the model covers. -/
def total.safe (a : Int) (b : Int) : Bool :=
  Ariadne.inRange (b * (2 : Int)) && Ariadne.inRange (a + (b * (2 : Int)))

def negate (x : Int) : Int :=
  (-x)

/-- The inputs on which `negate` stays within what the model covers. -/
def negate.safe (x : Int) : Bool :=
  Ariadne.inRange (-x)

def clampIndex (i : Int) (n : Int) : Int :=
  if decide (i < (0 : Int)) then
    (0 : Int)
  else
    if decide (i ≥ n) then
      n - (1 : Int)
    else
      i

/-- The inputs on which `clampIndex` stays within what the model covers. -/
def clampIndex.safe (i : Int) (n : Int) : Bool :=
  if decide (i < (0 : Int)) then
    true
  else
    if decide (i ≥ n) then
      Ariadne.inRange (n - (1 : Int))
    else
      true

def count (es : List Entry) : Int :=
  (es.length : Int)

def sizes (es : List Entry) : List Int :=
  es.map (fun e => e.size)

def named (es : List Entry) (name : JSString) : Option Entry :=
  es.find? (fun e => e.name == name)

def tagged (es : List Entry) (tag : JSString) : List Entry :=
  es.filter (fun e => e.tags.any (· == tag))

def anyLarge (es : List Entry) (limit : Int) : Bool :=
  es.any (fun e => decide (e.size > limit))

def allNamed (es : List Entry) : Bool :=
  es.all (fun e => decide ((e.name.length : Int) > (0 : Int)))

def bySize (es : List Entry) : List Entry :=
  Ariadne.sortedBy (fun a b => a.size - b.size) es

/-- The inputs on which `bySize` stays within what the model covers. -/
def bySize.safe (es : List Entry) : Bool :=
  Ariadne.sortSafe (fun a b => a.size - b.size) false (fun a b => Ariadne.inRange (a.size - b.size)) es

def byName (es : List Entry) : List Entry :=
  Ariadne.sortedBy (fun a b => if Ariadne.strLt a.name b.name then (-(1 : Int)) else if Ariadne.strLt b.name a.name then (1 : Int) else (0 : Int)) es

/-- The inputs on which `byName` stays within what the model covers. -/
def byName.safe (es : List Entry) : Bool :=
  Ariadne.consistent (Ariadne.signs (fun a b => if Ariadne.strLt a.name b.name then (-(1 : Int)) else if Ariadne.strLt b.name a.name then (1 : Int) else (0 : Int)) es)

def ids (es : List Entry) : List Int :=
  (0 : Int) :: ((es.map (fun e => e.id)) ++ ([(-(1 : Int))]))

def firstName (es : List Entry) : JSString :=
  let e : Option Entry := Ariadne.listIndex es (0 : Int)
  match e with
  | none =>
    (js "")
  | some e =>
    e.name

def grow (es : List Entry) («by» : Int) : List Entry :=
  es.map (fun e => (e.withSize (e.size + «by»)))

/-- The inputs on which `grow` stays within what the model covers. -/
def grow.safe (es : List Entry) («by» : Int) : Bool :=
  es.all (fun e => Ariadne.inRange (e.size + «by»))

def signs (xs : List Int) : List JSString :=
  xs.map (fun x => if decide (x > (0 : Int)) then (js "pos") else if x == (0 : Int) then (js "zero") else (js "neg"))

def scaled (xs : List Int) (k : Int) : List Int :=
  List.map (fun x => x * k) (xs.filter (fun x => x != (0 : Int)))

/-- The inputs on which `scaled` stays within what the model covers. -/
def scaled.safe (xs : List Int) (k : Int) : Bool :=
  List.all (xs.filter (fun x => x != (0 : Int))) (fun x => Ariadne.inRange (x * k))

def totalOf (es : List Entry) : Int :=
  total (count es) (1 : Int)

/-- The inputs on which `totalOf` stays within what the model covers. -/
def totalOf.safe (es : List Entry) : Bool :=
  total.safe (count es) (1 : Int)

def isLarge (e : Entry) : Bool :=
  decide (e.size > (100 : Int))

def bySizeDesc (a : Entry) (b : Entry) : Int :=
  if a.size != b.size then
    if decide (a.size > b.size) then (-(1 : Int)) else (1 : Int)
  else
    (0 : Int)

def large (es : List Entry) : List Entry :=
  es.filter isLarge

def ranked (es : List Entry) : List Entry :=
  Ariadne.sortedBy bySizeDesc es

/-- The inputs on which `ranked` stays within what the model covers. -/
def ranked.safe (es : List Entry) : Bool :=
  Ariadne.consistent (Ariadne.signs bySizeDesc es)

def flags (es : List Entry) : List Bool :=
  es.map (fun _ => false)

def summaries (es : List Entry) : List Entry :=
  es.map (fun e => (Entry.mk e.id (e.size + (1 : Int)) e.name ([])))

/-- The inputs on which `summaries` stays within what the model covers. -/
def summaries.safe (es : List Entry) : Bool :=
  es.all (fun e => Ariadne.inRange (e.size + (1 : Int)))

def missing (xs : List (Option Int)) : Int :=
  (List.length (xs.filter (fun x => x.isNone)) : Int)

