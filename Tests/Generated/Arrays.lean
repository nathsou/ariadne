def total (a : Int) (b : Int) : Int :=
  a + (b * (2 : Int))

/-- The inputs on which `total` stays within what the model covers. -/
def total.safe (a : Int) (b : Int) : Bool :=
  Ariadne.inRange (b * (2 : Int)) && Ariadne.inRange (a + (b * (2 : Int)))

def negate (x : Int) : Int :=
  (-x)

/-- The inputs on which `negate` stays within what the model covers. -/
def negate.safe (x : Int) : Bool :=
  Ariadne.inRange (-x)

def clampIndex (i : Int) (n : Int) : Int :=
  if decide (i < (0 : Int)) then
    (0 : Int)
  else
    if decide (i ≥ n) then
      n - (1 : Int)
    else
      i

/-- The inputs on which `clampIndex` stays within what the model covers. -/
def clampIndex.safe (i : Int) (n : Int) : Bool :=
  if decide (i < (0 : Int)) then
    true
  else
    if decide (i ≥ n) then
      Ariadne.inRange (n - (1 : Int))
    else
      true

