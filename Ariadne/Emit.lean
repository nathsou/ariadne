import Ariadne.Certificate
import Ariadne.Linker

namespace Ariadne

private def quote (s : String) : String := reprStr s

def leanName (name : String) : String :=
  "ts_" ++ String.ofList (name.toList.map fun c => if c.isAlphanum || c == '_' then c else '_')

/-- Emit a source-bound executable model. The printer is outside the proof boundary:
the generated source/AST equation must be checked by the kernel. -/
def emit (source : String) (program : Program) (namespace_ : String := "Translated") : String := Id.run do
  let mut out := "-- Generated by Ariadne. Regenerate this file; put user proofs in a separate module.\n"
  out := out ++ "import Ariadne.Certificate\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 0\n\n"
  out := out ++ s!"namespace {namespace_}\nopen Ariadne\n\ndef source : String := {quote source}\n\n"
  out := out ++ s!"def characters : List Char :=\n{reprStr source.toList}\n\n"
  out := out ++ "theorem characters_encoded : String.ofList characters = source := by kernel_rfl\n\n"
  out := out ++ "theorem characters_checked : source.toList = characters :=\n" ++
    "  characters_of_encoding characters_encoded\n\n"
  if let .ok tokens := lex source then
    out := out ++ s!"def tokens : Array Token :=\n{reprStr tokens}\n\n"
    out := out ++ "theorem lex_checked : lex source = .ok tokens := by\n  unfold lex\n  rw [characters_checked]\n  kernel_rfl\n\n"
  out := out ++ s!"def program : Program :=\n{reprStr program}\n\n"
  out := out ++ "theorem parse_checked : parse source = .ok program := by\n  unfold parse\n  rw [lex_checked]\n  kernel_rfl\n\n"
  out := out ++ "theorem types_checked : Check.program program = .ok () := by kernel_rfl\n\n"
  out := out ++ "theorem source_checked : frontend source = .ok program :=\n  frontend_of_parse parse_checked types_checked\n\n"
  out := out ++ "def certificate : Certificate source := ⟨program, source_checked⟩\n\n"
  for f in program.functions do
    let name := leanName f.name
    out := out ++ s!"/-- Executable, fuel-indexed model of TypeScript `{f.name}`. -/\n"
    out := out ++ s!"def {name} (fuel : Nat) (args : List Value) : Result Value :=\n  run program {quote f.name} fuel args\n\n"
    out := out ++ s!"theorem {name}_source " ++ "{fuel : Nat} {args : List Value} {value : Value}\n"
    out := out ++ s!"    (h : {name} fuel args = .ok value) : SourceReturns source {quote f.name} args value :=\n"
    out := out ++ "  certificate.transfer_at h\n\n"
  return out ++ s!"end {namespace_}\n"

/-- Emit the compiled function and a kernel-checkable equation tying the printed
term to the proof-carrying compiler. A printer bug cannot establish correctness. -/
def emitCompiled (source : String) (program : Program) (entry : String)
    (namespace_ : String := "Translated") : Checked String := do
  let compiled ← Compile.entry program entry
  let name := leanName entry
  let (declarations, targetText) ← match Compile.function program entry with
    | .ok _ => pure ("", compiled.text)
    | .error _ => do
      let table ← Compile.definitions program program.functions
      let definitions := "def compiled_definitions : List Target.Definition := [\n  " ++
        String.intercalate ",\n  " (table.texts.map fun text => text.replace "\n" "\n  ") ++ "]\n\n"
      let target := "(fun fuel args => (Target.link (apply program) compiled_definitions " ++
        "fuel fuel {} (.function " ++ quote entry ++ ") args).map Prod.fst)"
      pure (definitions, target)
  let base := (emit source program namespace_).replace
    "import Ariadne.Certificate\n" "import Ariadne.Certificate\nimport Ariadne.Linker\n"
  let out := base ++ s!"\nnamespace {namespace_}\nopen Ariadne\n\n" ++
    declarations ++
    s!"/-- Compiled scalar entry; named calls use the certified linked bodies. -/\n" ++
    s!"def compiled_{name} : Nat → List Value → Result Value :=\n  {targetText}\n\n" ++
    s!"theorem compilation_checked : (Compile.entry program {quote entry}).map Compile.Fragment.code =\n" ++
    s!"    .ok compiled_{name} := by kernel_rfl\n\n" ++
    s!"theorem compiled_correct : compiled_{name} = {name} :=\n" ++
    "  Compile.entry_correct compilation_checked\n\n" ++
    s!"theorem compiled_source " ++ "{fuel : Nat} {args : List Value} {value : Value}\n" ++
    s!"    (h : compiled_{name} fuel args = .ok value) : SourceReturns source {quote entry} args value := by\n" ++
    "  rw [compiled_correct] at h\n  exact certificate.transfer_at h\n\n" ++
    s!"end {namespace_}\n"
  return out

end Ariadne
