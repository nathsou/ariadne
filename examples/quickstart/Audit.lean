import Ariadne.Audit

/-!
# `lake exe audit [--write-lock]`

Fails unless every declaration (the project's and Ariadne's) re-checks with the kernel, theorems use only
the standard axioms, each proposition in `Quickstart.Spec` is proved exactly by the theorem of the same name
in `Quickstart.Proofs`, and `spec.lock` (the statements, and the definitions they mention) is unchanged.
`replay` replays Ariadne's declarations too, so a prebuilt Ariadne needs no trust.
-/

unsafe def main (args : List String) : IO UInt32 :=
  Ariadne.Audit.run {
    modules := #[`Quickstart]
    project := [`Quickstart]
    replay := [`Ariadne]
    lockNamespaces := [`Quickstart.Spec]
    specs := some (`Quickstart.Spec, `Quickstart.Proofs)
    lockPath := "spec.lock"
    lockHeader := "-- spec.lock: what the theorems state, and of what. Generated by `lake exe audit --write-lock`; review every change." } args
